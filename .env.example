# PrintPrice Pro - Environment Variables Example
# Duplicate this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (MySQL/MariaDB)
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://user:password@127.0.0.1:3306/preflight"

# Cache (Redis)
REDIS_URL="redis://127.0.0.1:6379"

# AI engine (Google Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# PPOS Integration
PPOS_SERVICE_URL="http://127.0.0.1:8001"
PPOS_INTERNAL_TENANT_ID="ppos-customer-1"
PPOS_INTERNAL_ROLE="ADMIN"
PPOS_INTERNAL_SCOPES="preflight:write,preflight:analyze,jobs:read"

# Security
JWT_SECRET="YOUR_STRONG_JWT_SECRET_HERE"
JWT_ALGORITHM=HS256
JWT_ISSUER="https://auth.printprice.pro"
JWT_AUDIENCE="ppos:control"
ADMIN_API_KEY="your-secret-admin-key"

# Debugging
DEBUG_AUTH_ROUTE=true
AUTO_MIGRATE=0
