# PrintPrice Pro - Environment Variables Example
# Duplicate this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (MySQL/MariaDB)
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://user:password@127.0.0.1:3306/preflight"

# Cache (Redis)
REDIS_URL="redis://127.0.0.1:6379"

# AI engine (Google Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# PPOS Integration (Preflight Engine — port 8001)
PPOS_SERVICE_URL="http://127.0.0.1:8001"
PPOS_INTERNAL_TENANT_ID="ppos-customer-1"
PPOS_INTERNAL_ROLE="ADMIN"
PPOS_INTERNAL_SCOPES="preflight:read,preflight:write,preflight:analyze,jobs:read,jobs:write"

# Security
JWT_SECRET="YOUR_STRONG_JWT_SECRET_HERE"
JWT_ALGORITHM=HS256
JWT_ISSUER="https://auth.printprice.pro"
JWT_AUDIENCE="ppos:control"
ADMIN_API_KEY="your-secret-admin-key"

# Debugging
DEBUG_AUTH_ROUTE=true
AUTO_MIGRATE=0

# ─── Phase 39.1: Control Plane Tenant Governance ─────────────────────────
# Control Plane Phase 39.0 runs on port 8081 (NOT 8002 — that was a placeholder).
# Canonical endpoint: GET /api/admin/tenant-governance/:tenantId/entitlements
#
# CONTROL_PLANE_INTERNAL_API_KEY and PPOS_CONTROL_TOKEN must be the same value.
CONTROL_PLANE_URL=http://127.0.0.1:8081
PPOS_CONTROL_PLANE_URL=http://127.0.0.1:8081
CONTROL_PLANE_INTERNAL_API_KEY=
PPOS_CONTROL_TOKEN=
CONTROL_PLANE_TIMEOUT_MS=8000
TENANT_ENTITLEMENT_CACHE_TTL_MS=60000
INFRA_MAX_FILE_SIZE_MB=2048

